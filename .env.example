# =============================================================================
# Profile Agent — Environment Variables
# Copy to .env and fill in values for local development.
# In Azure, these are injected via Container Apps config / Key Vault references.
# =============================================================================

# ---------- Runtime mode ----------
# "dev" = local development (SQLite, mock auth, console telemetry)
# "prod" = Azure production (Cosmos DB, Entra auth, Azure Monitor)
ENVIRONMENT=dev

# "web" = Chainlit + FastAPI UI on Container Apps
# "foundry" = Foundry hosting adapter on port 8088
RUN_MODE=web

# ---------- Azure AI Foundry ----------
FOUNDRY_PROJECT_ENDPOINT=https://sandbox-foundry-jvw.services.ai.azure.com/api/projects/rag-showcase
FOUNDRY_MODEL_DEPLOYMENT_NAME=gpt-5.2
FOUNDRY_IMAGE_DEPLOYMENT_NAME=gpt-image-1.5

# ---------- Azure OpenAI (if separate from Foundry) ----------
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_KEY=<azure-openai-api-key>
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# ---------- Azure Storage ----------
AZURE_STORAGE_ACCOUNT_URL=https://<account>.blob.core.windows.net
BLOB_CONTAINER_UPLOADS=uploads
BLOB_CONTAINER_CARDS=cards

# ---------- Cosmos DB ----------
COSMOS_ENDPOINT=https://<account>.documents.azure.com:443/
COSMOS_DATABASE_NAME=profileagent

# ---------- Key Vault ----------
KEY_VAULT_URL=https://<vault>.vault.azure.net/

# ---------- Application Insights ----------
APPINSIGHTS_CONNECTION_STRING=InstrumentationKey=...;IngestionEndpoint=...

# ---------- Microsoft Entra ID ----------
ENTRA_CLIENT_ID=<app-registration-client-id>
ENTRA_TENANT_ID=<tenant-id>
ENTRA_CLIENT_SECRET=<only-for-local-dev-use-keyvault-in-prod>
ENTRA_REDIRECT_URI=http://localhost:8000/api/auth/callback

# ---------- Managed Identity (prod only, optional override) ----------
# AZURE_CLIENT_ID=<user-assigned-managed-identity-client-id>

# ---------- Local dev overrides ----------
# DEV_AUTH_BYPASS=true
# DEV_MOCK_BLOB=true
