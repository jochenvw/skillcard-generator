# =============================================================================
# Profile Agent — Environment Variables (template)
# Copy to .env and fill in values for local development.
# =============================================================================

# ---------- Runtime mode ----------
# "dev" = local development | "prod" = Azure production
ENVIRONMENT=dev
# "web" = FastAPI + React UI | "foundry" = Foundry hosting adapter
RUN_MODE=web

# ---------- Azure AI Foundry (used for chat + image generation) ----------
FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
FOUNDRY_MODEL_DEPLOYMENT_NAME=gpt-5.4
FOUNDRY_IMAGE_DEPLOYMENT_NAME=gpt-image-2-1

# ---------- Azure OpenAI override (optional — defaults derived from Foundry) ----------
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_KEY=<api-key-if-not-using-AAD>
# AZURE_OPENAI_DEPLOYMENT=<deployment-name>
# AZURE_OPENAI_API_VERSION=2025-04-01-preview

# ---------- Application Insights (optional) ----------
# APPINSIGHTS_CONNECTION_STRING=InstrumentationKey=...;IngestionEndpoint=...

# ---------- Microsoft Entra ID (leave commented for anonymous local dev) ----------
# ENTRA_CLIENT_ID=<app-registration-client-id>
# ENTRA_TENANT_ID=<tenant-id>
# ENTRA_CLIENT_SECRET=<client-secret>
# ENTRA_REDIRECT_URI=http://localhost:8000/api/auth/callback

# ---------- Managed Identity (prod only, optional override) ----------
# AZURE_CLIENT_ID=<user-assigned-managed-identity-client-id>

# ---------- Local dev flags ----------
# DEV_AUTH_BYPASS=true
